# ===========================
# UniServe - Environment Configuration
# ===========================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ---- Application ----
APP_NAME=UniServe
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- Database ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=uniserve
POSTGRES_PASSWORD=uniserve_dev_password
POSTGRES_DB=uniserve_dev
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- JWT Authentication ----
JWT_SECRET_KEY=change-me-in-production-use-a-strong-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- OTP Configuration ----
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=3

# ---- PIN Configuration ----
PIN_LENGTH=4
PIN_MAX_FAILED_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15

# ---- Rate Limiting ----
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=30
PASSWORD_RESET_MAX_REQUESTS=5

# ---- University Email Patterns ----
# JSON object mapping user categories to regex patterns
# UNIVERSITY_EMAIL_PATTERNS={"student":["^fa\\d{2}-.+\\.lgu\\.edu\\.pk$",".+@student\\.lgu\\.edu\\.pk$"],"faculty":["^[a-z].*@lgu\\.edu\\.pk$",".+@faculty\\.lgu\\.edu\\.pk$"]}

# ---- CORS ----
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# ---- Logging ----
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# ---- Email (future) ----
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=

# ---- Payment Gateway (future) ----
# PAYMENT_API_KEY=
# PAYMENT_WEBHOOK_SECRET=
