# ===========================
# UniServe - Environment Configuration
# ===========================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ---- Application ----
APP_NAME=UniServe
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- Database ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=uniserve
POSTGRES_PASSWORD=uniserve_dev_password
POSTGRES_DB=uniserve_dev
# UNUSED / INERT: Settings builds the database URL from the discrete
# POSTGRES_* fields above; this interpolation line is never read.
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- JWT Authentication ----
JWT_SECRET_KEY=change-me-in-production-use-a-strong-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- OTP Configuration ----
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=3

# ---- PIN Configuration ----
PIN_LENGTH=4
PIN_MAX_FAILED_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15

# ---- Rate Limiting ----
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=30
PASSWORD_RESET_MAX_REQUESTS=5

# ---- University Email Patterns ----
# JSON object mapping user categories to regex patterns
# UNIVERSITY_EMAIL_PATTERNS={"student":["^fa\\d{2}-.+\\.lgu\\.edu\\.pk$",".+@student\\.lgu\\.edu\\.pk$"],"faculty":["^[a-z].*@lgu\\.edu\\.pk$",".+@faculty\\.lgu\\.edu\\.pk$"]}

# ---- CORS ----
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# ---- Logging ----
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# ---- Email / SMTP (production OTP delivery) ----
# Standard SMTP transport (app/core/email.py SMTPEmailProvider).
# Development/test log OTPs to the console — SMTP is unused there.
# In production, set SMTP_HOST + SMTP_FROM_EMAIL (and credentials as
# needed); without them OTP delivery fails closed. Real values live
# only in server-side environment files — never commit credentials.
# SMTP_TLS_MODE: starttls (default, port 587) | ssl (port 465) | none
#   (none is rejected in production by Settings validation).
SMTP_HOST=                 # e.g. smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=           # e.g. noreply@example.com
SMTP_TLS_MODE=starttls

# ---- Online Payments ----
# Provider-neutral configuration (backend-only — never in frontend code).
# PAYMENT_PROVIDER=test selects the mock provider (dev/test only).
# Set PAYMENT_PROVIDER to a registered real provider name to enable
# online payments; unknown names fail closed (HTTP 503).
# PAYMENT_PROVIDER=test
# PAYMENT_ENVIRONMENT=sandbox
# PAYMENT_MERCHANT_ID=
# PAYMENT_API_KEY=
# PAYMENT_API_SECRET=
# PAYMENT_WEBHOOK_SECRET=
# PAYMENT_CALLBACK_URL=https://api.example.com/api/v1/payments/webhook/<provider>
