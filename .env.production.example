# ===========================
# UniServe — Production Environment Variables
# ===========================
# Copy this file to .env.production and fill in ALL values.
# NEVER commit .env.production to version control.
# NEVER use development defaults in production.

# ---- Application ----
APP_NAME=UniServe
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=              # REQUIRED: Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- PostgreSQL ----
POSTGRES_HOST=postgres       # Docker service name — do NOT change
POSTGRES_PORT=5432           # Internal Docker port — do NOT change
POSTGRES_USER=uniserve       # REQUIRED: Set a strong username
POSTGRES_PASSWORD=           # REQUIRED: Set a strong password (min 32 chars)
POSTGRES_DB=uniserve_prod    # REQUIRED: Production database name

# ---- JWT Authentication ----
JWT_SECRET_KEY=              # REQUIRED: Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
# Set to your production domains. Example:
CORS_ORIGINS=["https://app.example.com"]
# For mobile apps, CORS is not needed (native HTTP client, no browser).

# ---- Logging ----
LOG_LEVEL=INFO               # Do NOT use DEBUG in production
LOG_FORMAT=json

# ---- OTP ----
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=3

# ---- PIN ----
PIN_LENGTH=4
PIN_MAX_FAILED_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15

# ---- Business Rules ----
REFUND_DEADLINE_HOURS=72
PICKUP_WINDOW_MINUTES=30
DEFAULT_PREPARATION_TIME_MINUTES=15
DEFAULT_CAPACITY=10

# ---- No-Show Policy ----
NOSHOW_STUDENT_THRESHOLD=3
NOSHOW_STUDENT_WINDOW_DAYS=30
NOSHOW_STUDENT_SUSPENSION_DAYS=7
NOSHOW_FACULTY_THRESHOLD=5
NOSHOW_FACULTY_WINDOW_DAYS=30
NOSHOW_FACULTY_SUSPENSION_DAYS=3

# University email patterns (student/faculty derivation) are defined in
# code — apps/api/app/core/config.py UNIVERSITY_EMAIL_PATTERNS — with
# lgu.edu.pk defaults. Override only if your university's format differs.

# ---- Rate Limiting ----
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=30
PASSWORD_RESET_MAX_REQUESTS=5

# ---- Email / SMTP (production OTP delivery) ----
# Standard SMTP transport (app/core/email.py SMTPEmailProvider).
# Provider-neutral — no vendor SDK. The external SMTP account is a
# deployment prerequisite: without SMTP_HOST + SMTP_FROM_EMAIL, OTP
# emails fail closed (reported failure, never fake success).
# SMTP_TLS_MODE: starttls (default, port 587) | ssl (port 465) |
# none — REJECTED in production (plaintext SMTP fails startup validation).
SMTP_HOST=smtp.example.com       # REQUIRED for self-serve onboarding in production
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com  # REQUIRED — sender address
SMTP_TLS_MODE=starttls

# ---- Online Payments ----
# Backend-only secrets — NEVER commit real values, NEVER expose via
# NEXT_PUBLIC_* or mobile app configuration.
# Online payments stay disabled (HTTP 503 on initiation) until
# PAYMENT_PROVIDER is set to a registered real provider and its
# credentials are configured. The test/mock provider is rejected in
# production by design.
# PAYMENT_PROVIDER=
# PAYMENT_ENVIRONMENT=production
# PAYMENT_MERCHANT_ID=
# PAYMENT_API_KEY=
# PAYMENT_API_SECRET=
# PAYMENT_WEBHOOK_SECRET=
# PAYMENT_CALLBACK_URL=https://api.example.com/api/v1/payments/webhook/<provider>
