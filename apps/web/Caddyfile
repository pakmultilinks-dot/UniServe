# UniServe — Caddyfile (reverse proxy + static files)
# This config is used in the Docker production setup.
# Replace example.com with your actual domain.

# API server — reverse proxy
api.example.com {
    reverse_proxy uniserve_api:8000 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # Disable Caddy logging for health checks
    log {
        output stdout
        format json
    }
}

# Web application — static files
app.example.com {
    root * /srv

    # Next.js static assets — long cache
    @static path /_next/static/*
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Next.js image assets
    @images path /_next/image/*
    header @images Cache-Control "public, max-age=86400"

    # SPA fallback — serve index.html for client-side routes
    try_files {path} /index.html

    file_server

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        -Server
    }

    log {
        output stdout
        format json
    }
}
