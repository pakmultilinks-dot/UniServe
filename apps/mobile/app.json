{
  "expo": {
    "name": "UniServe",
    "slug": "uniserve-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "uniserve",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uniserve.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f6efdf"
      },
      "package": "com.uniserve.mobile"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6efdf"
        }
      ]
    ]
  }
}
