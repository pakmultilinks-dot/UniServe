# UniServe API — Environment Variables
# Copy this file to .env and fill in the values.

# ---- Application ----
APP_NAME=UniServe
APP_ENV=development          # development | testing | staging | production
APP_DEBUG=true               # Set to false in production
APP_SECRET_KEY=change-me-in-production
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=uniserve
POSTGRES_PASSWORD=uniserve_dev_password
POSTGRES_DB=uniserve_dev

# ---- JWT ----
JWT_SECRET_KEY=change-me-in-production-use-a-strong-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- CORS (JSON array of origins — pydantic parses list[str] from JSON) ----
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# ---- Logging ----
LOG_LEVEL=INFO               # DEBUG in development, INFO or WARNING in production
LOG_FORMAT=json

# ---- OTP ----
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=3

# ---- PIN ----
PIN_LENGTH=4
PIN_MAX_FAILED_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15

# ---- Business Rules ----
REFUND_DEADLINE_HOURS=72
PICKUP_WINDOW_MINUTES=30
DEFAULT_PREPARATION_TIME_MINUTES=15
NOSHOW_STUDENT_THRESHOLD=3
NOSHOW_FACULTY_THRESHOLD=5

# ---- Rate Limiting ----
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=30
PASSWORD_RESET_MAX_REQUESTS=5

# ---- Email / SMTP (production OTP delivery) ----
# Standard SMTP transport (app/core/email.py SMTPEmailProvider).
# Development/test log OTPs to the console — SMTP is unused there.
# In production, set SMTP_HOST + SMTP_FROM_EMAIL (and credentials as
# needed); without them OTP delivery fails closed. Real values live
# only in server-side environment files — never commit credentials.
# SMTP_TLS_MODE: starttls (default, port 587) | ssl (port 465) | none
#   (none is rejected in production by Settings validation).
SMTP_HOST=                 # e.g. smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=           # e.g. noreply@example.com
SMTP_TLS_MODE=starttls
